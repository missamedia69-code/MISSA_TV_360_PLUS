<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero_carousel_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/missa_hero_height"
    android:layout_marginBottom="4dp">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/hero_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Freshness / Data Saver badge top-end -->
    <TextView
        android:id="@+id/hero_freshness_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/missa_section_horizontal_padding"
        android:background="@drawable/missa_eyebrow_pill_bg"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textAppearance="@style/TextAppearance.Missa.Caption"
        android:textColor="@color/missaHeroSubtext"
        android:visibility="gone"
        tools:text="Mis à jour il y a 2 min"
        tools:visibility="visible" />

    <!-- Slide indicator dots bottom-end -->
    <LinearLayout
        android:id="@+id/hero_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/missa_hero_padding"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal" />

</FrameLayout>
