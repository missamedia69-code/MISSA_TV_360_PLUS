<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero_slide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hero_backdrop_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/missaHeroBackdropFallback"
        android:contentDescription="@string/universe_featured_content"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/missa_hero_scrim_cinematic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/missa_hero_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/missa_hero_padding"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/missa_eyebrow_pill_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textAppearance="@style/TextAppearance.Missa.Badge"
                android:textColor="@color/missaGreenSuccessDark"
                tools:text="★ À L’AFFICHE" />

            <TextView
                android:id="@+id/hero_sources_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/missa_eyebrow_pill_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textAppearance="@style/TextAppearance.Missa.Badge"
                android:textColor="@color/missaYellowPrimary"
                android:visibility="gone"
                tools:text="3 sources"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="@color/missaOnAccentDark"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textAppearance="@style/TextAppearance.Missa.ScreenTitle"
            android:textColor="@color/missaHeroText"
            tools:text="Le Comte de Monte-Cristo" />

        <TextView
            android:id="@+id/hero_meta_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Missa.Caption"
            android:textColor="@color/missaYellowPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="2024  •  2h 58m  •  ★ 8.4"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/hero_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Missa.Body"
            android:textColor="@color/missaHeroSubtext"
            tools:text="Victime d’un complot, le jeune Edmond Dantès est arrêté le jour de son mariage." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hero_primary_cta"
                style="@style/Widget.Missa.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/universe_hero_watch"
                app:icon="@drawable/ic_baseline_play_arrow_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hero_details_cta"
                style="@style/Widget.Missa.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/universe_hero_more_info"
                app:icon="@drawable/ic_outline_info_24" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
