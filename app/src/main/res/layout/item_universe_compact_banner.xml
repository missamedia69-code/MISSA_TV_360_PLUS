<?xml version="1.0" encoding="utf-8"?>
<!-- Shown ONLY when Hero carousel is absent (HOME-01: no duplicate title below Hero) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/universe_compact_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/missa_section_horizontal_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/missa_section_horizontal_padding"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/compact_universe_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        app:tint="?attr/missaAccentPrimary"
        tools:src="@drawable/baseline_theaters_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/compact_universe_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Missa.ScreenTitle"
            tools:text="Films" />

        <TextView
            android:id="@+id/compact_universe_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Missa.Caption"
            tools:text="Longs-métrages, nouveautés et classiques." />
    </LinearLayout>

    <TextView
        android:id="@+id/compact_special_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/missa_pill_360"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.Missa.Badge"
        android:textColor="@color/missaOnRedLive"
        android:visibility="gone"
        tools:text="SÉLECTION JEUNESSE"
        tools:visibility="visible" />

</LinearLayout>
