<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/games_swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- En-tête : titre, état de la manette, actions et filtres par console -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/missaSurfaceElevated"
            android:orientation="vertical"
            android:paddingStart="@dimen/missa_section_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/missa_section_horizontal_padding"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Missa.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/universe_eyebrow_games"
                        android:textColor="?attr/missaAccentPrimary" />

                    <TextView
                        style="@style/TextAppearance.Missa.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityHeading="true"
                        android:text="@string/universe_games_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/games_controller_badge"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/missa_eyebrow_pill_bg"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:maxLines="2"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="?attr/missaAccentSuccess"
                    tools:text="Manette prête" />
            </LinearLayout>

            <TextView
                android:id="@+id/games_intro"
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/universe_games_intro" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/games_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/games_refresh_button"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginEnd="10dp"
                        android:text="@string/universe_games_refresh" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/missaStrokeSubtle" />

        <TextView
            android:id="@+id/games_status"
            style="@style/TextAppearance.Missa.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:visibility="gone"
            tools:text="Catalogue indisponible"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/games_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_game_card" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
