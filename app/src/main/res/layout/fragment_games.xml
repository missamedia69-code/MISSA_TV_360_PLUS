<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/games_swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- En-tête : titre, état de la manette, actions et filtres par console -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/missaSurfaceElevated"
            android:orientation="vertical"
            android:paddingStart="@dimen/missa_section_horizontal_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/missa_section_horizontal_padding"
            android:paddingBottom="8dp">

            <!-- Bannière NEO-GEO Classic Games de l'univers Jeux (elle sert de titre de l'écran),
                 libre de texte sauf une pastille d'information (nombre de jeux). -->
            <FrameLayout
                android:id="@+id/games_banner_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/games_banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/universe_games_banner_desc"
                    android:importantForAccessibility="yes"
                    android:maxHeight="@dimen/missa_games_banner_max_height"
                    android:scaleType="fitCenter"
                    android:src="@drawable/missa_games_banner"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Missa.GamesBanner" />

                <!-- Seule pastille posée sur la bannière : le nombre de jeux disponibles. -->
                <TextView
                    android:id="@+id/games_banner_info"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/missa_banner_overlay_pill_bg"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="17 jeux · Neo Geo"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Rangée compacte sous la bannière : Actualiser (et filtres), puis l'état de la
                 manette et l'aide, l'un sous l'autre, sur une seule hauteur de bouton. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/games_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/games_refresh_button"
                            style="@style/Widget.Missa.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/missa_pill_touch_height"
                            android:layout_marginEnd="10dp"
                            android:text="@string/universe_games_refresh" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/games_controller_badge"
                        style="@style/TextAppearance.Missa.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/missaAccentSuccess"
                        android:textSize="12sp"
                        tools:text="Commandes tactiles à l'écran" />

                    <TextView
                        android:id="@+id/games_intro"
                        style="@style/TextAppearance.Missa.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/universe_games_intro"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/missaStrokeSubtle" />

        <TextView
            android:id="@+id/games_status"
            style="@style/TextAppearance.Missa.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:visibility="gone"
            tools:text="Catalogue indisponible"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/games_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_game_tile" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
