<?xml version="1.0" encoding="utf-8"?>
<!-- Styled See-All full-grid BottomSheet with Sort chips (HOME-10) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <View
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/missaAccentPrimary" />

        <TextView
            android:id="@+id/see_all_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Missa.RowTitle"
            tools:text="Tendances &amp; Nouveautés" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/see_all_close_btn"
            style="@style/Widget.Missa.Button.Icon"
            android:contentDescription="@string/cancel"
            app:icon="@drawable/ic_baseline_close_24" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/see_all_sort_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/see_all_grid_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="28dp" />

</LinearLayout>
