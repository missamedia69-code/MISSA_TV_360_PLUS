<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resume_section_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/missa_section_gap_top"
    android:paddingBottom="@dimen/missa_section_gap_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/missa_section_horizontal_padding"
        android:paddingEnd="@dimen/missa_section_horizontal_padding"
        android:paddingBottom="@dimen/missa_section_title_gap">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/missaAccentPrimary" />

        <TextView
            android:id="@+id/resume_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/universe_resume_watching_title"
            android:textAppearance="@style/TextAppearance.Missa.RowTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resume_clear_all_btn"
            style="@style/Widget.Missa.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/universe_resume_clear_all" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resume_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:orientation="horizontal"
        android:paddingStart="@dimen/missa_section_horizontal_padding"
        android:paddingEnd="@dimen/missa_section_horizontal_padding"
        tools:listitem="@layout/home_result_grid" />

</LinearLayout>
