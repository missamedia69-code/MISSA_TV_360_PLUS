<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_deck_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/missa_section_horizontal_padding"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/missa_section_horizontal_padding"
    android:layout_marginBottom="8dp"
    android:background="@drawable/missa_universe_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Responsive Stage Row: Vertical on Portrait Phone, Side-by-Side Studio Console on Landscape / Android TV -->
    <LinearLayout
        android:id="@+id/music_deck_stage_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Left / Top Monitor: Live Video Clip Stage + Authentic HD Cover Sleeve -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/music_deck_monitor_card"
            android:layout_width="match_parent"
            android:layout_height="204dp"
            app:cardBackgroundColor="?attr/primaryBlackBackground"
            app:cardCornerRadius="@dimen/missa_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/missaStrokeSubtle"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Authentic Studio Cover / Clip Backdrop -->
                <ImageView
                    android:id="@+id/music_deck_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/missaSurfaceElevated"
                    android:importantForAccessibility="no"
                    android:padding="44dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_missa_music"
                    app:tint="?attr/missaAccentPrimary" />

                <!-- Live Playing Clip Video Monitor (TextureView clips smoothly inside RecyclerView) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/music_deck_video_surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone"
                    app:resize_mode="zoom"
                    app:shutter_background_color="@android:color/transparent"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <!-- Subtle Top/Bottom Scrim for HUD Pill Contrast -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/missa_hero_scrim_cinematic" />

                <!-- Top-Left Live Status Pill -->
                <TextView
                    android:id="@+id/music_deck_live_badge"
                    style="@style/TextAppearance.Missa.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/missa_eyebrow_pill_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/universe_music_badge_idle"
                    android:textColor="?attr/missaAccentPrimary"
                    android:textStyle="bold" />

                <!-- Top-Right Fullscreen Clip Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_deck_fullscreen_btn"
                    style="@style/Widget.Missa.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:contentDescription="@string/universe_music_fullscreen"
                    android:minHeight="36dp"
                    android:minWidth="40dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/universe_music_fullscreen"
                    app:icon="@drawable/baseline_fullscreen_24"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right / Bottom Studio MP3 Controls & Digital Readout -->
        <LinearLayout
            android:id="@+id/music_deck_controls_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Eyebrow + Quick Mode / Playlist / Styles Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_deck_eyebrow"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/universe_music_eyebrow_idle"
                    android:textAllCaps="true"
                    android:textColor="?attr/missaAccentPrimary"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/music_deck_mode_btn"
                            style="@style/Widget.Missa.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:minHeight="38dp"
                            android:paddingHorizontal="10dp"
                            android:text="@string/universe_music_mode_clip"
                            app:icon="@drawable/ic_baseline_ondemand_video_24"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/music_deck_queue_btn"
                            style="@style/Widget.Missa.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:minHeight="38dp"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone"
                            app:icon="@drawable/ic_baseline_playlist_play_24"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/music_deck_add_server_btn"
                            style="@style/Widget.Missa.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@string/universe_music_styles_manage_title"
                            android:minHeight="38dp"
                            android:paddingHorizontal="10dp"
                            android:text="@string/universe_music_add_server"
                            app:icon="@drawable/ic_baseline_tune_24"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="16dp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Track / Clip Title -->
            <TextView
                android:id="@+id/music_deck_title"
                style="@style/TextAppearance.Missa.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/universe_music_player_title" />

            <!-- Artist • Album / Style • Status -->
            <TextView
                android:id="@+id/music_deck_status"
                style="@style/TextAppearance.Missa.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/universe_music_player_idle"
                android:textColor="?attr/grayTextColor" />

            <!-- Precision Digital Timecode Scrubber -->
            <LinearLayout
                android:id="@+id/music_deck_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_deck_position"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="42dp"
                    android:text="@string/universe_music_zero_time"
                    android:textColor="?attr/textColor"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/music_deck_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:max="1000"
                    android:progress="0"
                    android:progressBackgroundTint="?attr/missaStrokeSubtle"
                    android:progressTint="?attr/missaAccentPrimary"
                    android:thumbTint="?attr/missaAccentPrimary" />

                <TextView
                    android:id="@+id/music_deck_duration"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="42dp"
                    android:text="@string/universe_music_zero_time" />
            </LinearLayout>

            <!-- Sophisticated Hi-Fi Transport Deck -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_shuffle_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:contentDescription="@string/universe_music_shuffle"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/ic_missa_shuffle"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_prev_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/universe_music_prev"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/baseline_skip_previous_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_play_btn"
                        style="@style/Widget.Missa.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginHorizontal="8dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/universe_hero_listen"
                        app:icon="@drawable/ic_baseline_play_arrow_24"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_next_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:contentDescription="@string/universe_music_next"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/ic_baseline_skip_next_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_repeat_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/universe_music_repeat"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/ic_missa_repeat"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_fav_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/universe_music_favorite"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/ic_baseline_favorite_border_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_sleep_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/universe_radio_sleep_timer"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/ic_baseline_tune_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_deck_stop_btn"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/universe_music_stop"
                        android:minWidth="@dimen/missa_pill_touch_height"
                        android:paddingHorizontal="12dp"
                        app:icon="@drawable/baseline_stop_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Up-Next Preview Readout -->
            <TextView
                android:id="@+id/music_deck_up_next"
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
