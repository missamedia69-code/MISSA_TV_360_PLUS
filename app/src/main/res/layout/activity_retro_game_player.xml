<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/retro_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    tools:context=".ui.universe.RetroGamePlayerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/retro_player_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/universe_retro_player_title"
            android:textColor="@color/colorPrimaryDandelionYellow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/retro_player_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/whiteText"
            android:textSize="12sp"
            tools:text="Moteur prêt" />

        <Button
            android:id="@+id/retro_player_engine_button"
            style="@style/WhiteButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="@string/universe_retro_download_engine"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_player_pause_button"
            style="@style/BlackButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="@string/universe_retro_pause"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/retro_player_exit_button"
            style="@style/BlackButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="@string/universe_retro_exit"
            android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#080B10">

        <ImageView
            android:id="@+id/retro_game_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/universe_retro_player_title"
            android:focusable="false"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/retro_player_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/universe_retro_controls"
        android:textColor="#B8C0CC"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/retro_touch_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/retro_pad_left"
            style="@style/BlackButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="◀"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_up"
            style="@style/BlackButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="▲"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_down"
            style="@style/BlackButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="▼"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_right"
            style="@style/BlackButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="▶"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_select"
            style="@style/BlackButton"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="SELECT"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_start"
            style="@style/BlackButton"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="START"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_b"
            style="@style/BlackButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="B"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/retro_pad_a"
            style="@style/WhiteButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:text="A"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/retro_player_credits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/universe_retro_engine_notice"
        android:textColor="#8C95A3"
        android:textSize="10sp" />

</LinearLayout>