<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlist_track_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:clickable="false"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    app:cardBackgroundColor="?attr/missaSurfaceElevated"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/missaStrokeSubtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Tactile Drag-and-Drop Handle (Touch drag initiator, skipped by TV D-Pad) -->
        <ImageView
            android:id="@+id/playlist_track_drag_handle"
            android:layout_width="34dp"
            android:layout_height="48dp"
            android:clickable="false"
            android:contentDescription="@string/universe_music_queue_drag_a11y"
            android:focusable="false"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_missa_drag_handle"
            app:tint="?attr/grayTextColor" />

        <!-- Primary Playable & Focusable Track Target (Sibling of the ⋮ Menu Button) -->
        <LinearLayout
            android:id="@+id/playlist_track_main_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/missa_primary_btn_focus_foreground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp">

            <!-- Track Number (01, 02…) or ▶ / ⏸ Active Indicator -->
            <TextView
                android:id="@+id/playlist_track_index"
                style="@style/TextAppearance.Missa.Body"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/grayTextColor"
                android:textStyle="bold" />

            <!-- Clip / Cover Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playlist_track_thumb_card"
                android:layout_width="64dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="?attr/primaryBlackBackground"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/missaStrokeSubtle"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/playlist_track_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_missa_music" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Clip Title + Artist -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playlist_track_title"
                    style="@style/TextAppearance.Missa.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/textColor"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playlist_track_artist"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/grayTextColor" />
            </LinearLayout>

            <!-- Active Playing / Paused Pill -->
            <TextView
                android:id="@+id/playlist_track_playing_badge"
                style="@style/TextAppearance.Missa.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/missa_eyebrow_pill_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/universe_music_track_now_playing"
                android:textColor="?attr/missaAccentPrimary"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Clip Duration -->
            <TextView
                android:id="@+id/playlist_track_duration"
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:minWidth="38dp"
                android:textColor="?attr/grayTextColor" />
        </LinearLayout>

        <!-- Focusable Contextual Actions Menu Button (⋮) -->
        <ImageButton
            android:id="@+id/playlist_track_more_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/universe_music_queue_more_a11y"
            android:focusable="true"
            android:foreground="@drawable/missa_primary_btn_focus_foreground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:tint="?attr/textColor" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
