<?xml version="1.0" encoding="utf-8"?>
<!-- 4-state empty / offline / onboarding / filter card (HOME-06) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/missa_section_horizontal_padding"
    android:background="@drawable/missa_universe_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="26dp">

    <ImageView
        android:id="@+id/empty_state_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_baseline_extension_24"
        app:tint="?attr/missaAccentPrimary" />

    <TextView
        android:id="@+id/empty_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Missa.RowTitle"
        tools:text="Aucune source vidéo configurée" />

    <TextView
        android:id="@+id/empty_state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/universe_empty_home"
        android:textAppearance="@style/TextAppearance.Missa.Body"
        android:textColor="?attr/grayTextColor" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_state_primary_action"
            style="@style/Widget.Missa.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/universe_hero_manage_plugins" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_state_secondary_action"
            style="@style/Widget.Missa.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/universe_refresh"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
