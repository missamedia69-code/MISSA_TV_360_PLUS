<?xml version="1.0" encoding="utf-8"?>
<!-- Responsive multi-column grid for search/filter results (HOME-07) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/missa_section_horizontal_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/missa_section_horizontal_padding"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/missaAccentPrimary" />

        <TextView
            android:id="@+id/search_grid_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Missa.RowTitle"
            tools:text="Résultats pour « Dune »" />

        <TextView
            android:id="@+id/search_grid_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Missa.Caption"
            tools:text="14 titres" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_grid_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/home_result_grid" />

</LinearLayout>
