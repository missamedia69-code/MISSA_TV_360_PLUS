<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/missa_section_horizontal_padding"
        android:paddingEnd="@dimen/missa_section_horizontal_padding"
        android:paddingBottom="4dp">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/missaAccentPrimary" />

        <TextView
            android:id="@+id/row_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Missa.RowTitle"
            tools:text="Films à l’affiche" />

        <TextView
            android:id="@+id/row_category_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Missa.Caption"
            tools:text="24 titres" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_see_all_button"
            style="@style/Widget.Missa.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/universe_see_all" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/row_child_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:orientation="horizontal"
        android:paddingStart="@dimen/missa_section_horizontal_padding"
        android:paddingEnd="@dimen/missa_section_horizontal_padding"
        tools:listitem="@layout/home_result_grid" />

</LinearLayout>
