<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:fillViewport="true">

    <!-- Écran de fin d'essai / d'abonnement : choix de la formule, puis paiement.
         Téléphone et tablette : toucher une formule ouvre le paiement.
         TV : la formule sélectionnée s'affiche en QR code, à scanner avec le téléphone. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/activation_title"
            style="@style/TextAppearance.Missa.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/missa_activation_title" />

        <TextView
            android:id="@+id/activation_message"
            style="@style/TextAppearance.Missa.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:text="@string/missa_activation_trial_over" />

        <TextView
            style="@style/TextAppearance.Missa.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/missa_activation_choose" />

        <!-- Quatre formules, en deux rangées de deux (remplies par le code). -->
        <LinearLayout
            android:id="@+id/activation_plans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <ImageView
            android:id="@+id/activation_qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/white"
            android:contentDescription="@string/missa_activation_qr_desc"
            android:padding="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/activation_qr_hint"
            style="@style/TextAppearance.Missa.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.Missa.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/missa_activation_your_code" />

        <TextView
            android:id="@+id/activation_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:textColor="?attr/missaAccentNavigation"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Missa.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:text="@string/missa_activation_two_devices" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/activation_link"
                style="@style/Widget.Missa.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/missa_activation_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/activation_check"
                style="@style/Widget.Missa.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/missa_activation_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/activation_quit"
                style="@style/Widget.Missa.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/missa_activation_quit" />
        </LinearLayout>

        <TextView
            android:id="@+id/activation_status"
            style="@style/TextAppearance.Missa.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="560dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/activation_help"
            style="@style/Widget.Missa.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/missa_support_need_help"
            app:icon="@drawable/baseline_help_outline_24" />
    </LinearLayout>
</ScrollView>
