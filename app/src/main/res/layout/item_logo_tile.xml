<?xml version="1.0" encoding="utf-8"?>
<!--
    Petite tuile « logo seul » des univers Radio et TV en direct : le logo de la chaîne dans
    un carré, son nom en dessous. Beaucoup plus compacte que les cartes des autres univers
    (environ 10 par rangée sur un téléviseur) et légère à charger : le logo est décodé à la
    taille de la tuile, jamais en pleine résolution.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/missa_universe_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/logo_tile_box"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/missa_radio_logo_tile"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/logo_tile_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/logo_tile_monogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="?attr/missaAccentPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="RFI" />

            <TextView
                android:id="@+id/logo_tile_favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:importantForAccessibility="no"
                android:text="★"
                android:textColor="?attr/missaAccentPrimary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/logo_tile_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/missa_eyebrow_pill_bg"
                android:importantForAccessibility="no"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/logo_tile_playing"
                android:textColor="?attr/missaAccentSuccess"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/logo_tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:lines="2"
        android:maxLines="2"
        android:textColor="?attr/textColor"
        android:textSize="12sp"
        tools:text="Radio Balafon 90.3 Douala" />
</LinearLayout>
