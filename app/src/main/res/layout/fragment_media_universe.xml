<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media_universe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:orientation="vertical"
    tools:context=".ui.universe.MediaUniverseFragment">

    <!-- Sticky compact filter & category strip (HOME-01, HOME-08, NAV-04, TRUST-01) -->
    <LinearLayout
        android:id="@+id/universe_sticky_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/primaryBlackBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/missa_section_horizontal_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/missa_section_horizontal_padding"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/universe_category_pills_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:scrollbars="none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/universe_kids_pin_btn"
                style="@style/Widget.Missa.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/universe_kids_set_pin"
                android:visibility="gone"
                app:icon="@drawable/kid_star_24px"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/universe_source_filter_btn"
                style="@style/Widget.Missa.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                app:icon="@drawable/ic_baseline_tune_24"
                tools:text="Sources (4)"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/universe_toggle_filter_btn"
                style="@style/Widget.Missa.Button.Icon"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/universe_search_action"
                app:icon="@drawable/search_icon" />
        </LinearLayout>

        <!-- Collapsible scoped in-universe filter & search panel (HOME-01, NAV-04, HOME-07) -->
        <LinearLayout
            android:id="@+id/universe_inline_filter_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/missa_universe_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/search_icon"
                    app:tint="?attr/grayTextColor" />

                <EditText
                    android:id="@+id/universe_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:hint="@string/universe_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Missa.Body"
                    android:textColorHint="?attr/grayTextColor" />

                <ImageButton
                    android:id="@+id/universe_voice_search_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/universe_voice_search"
                    android:src="@drawable/ic_baseline_volume_up_24"
                    android:visibility="gone"
                    app:tint="?attr/textColor" />

                <ImageButton
                    android:id="@+id/universe_search_clear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/universe_reset_filters"
                    android:src="@drawable/ic_baseline_close_24"
                    android:visibility="gone"
                    app:tint="?attr/grayTextColor"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/universe_search_submit"
                    style="@style/Widget.Missa.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/universe_search_action" />
            </LinearLayout>

            <TextView
                android:id="@+id/universe_search_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Missa.Caption"
                android:textColor="?attr/missaAccentSuccess"
                android:visibility="gone"
                tools:text="4/8 sources queried"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/universe_recent_searches_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/universe_recent_searches_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/universe_loading_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/missaAccentPrimary"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/universe_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/universe_master_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingBottom="32dp"
            android:scrollbars="none" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
