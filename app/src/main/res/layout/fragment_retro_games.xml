<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/retro_swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Compact Header & Console Filter Bar -->
        <LinearLayout
            android:id="@+id/retro_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/missaSurfaceElevated"
            android:orientation="vertical"
            android:paddingStart="@dimen/missa_section_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/missa_section_horizontal_padding"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/retro_eyebrow"
                        style="@style/TextAppearance.Missa.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/universe_eyebrow_games"
                        android:textColor="?attr/missaAccentPrimary" />

                    <TextView
                        android:id="@+id/retro_title"
                        style="@style/TextAppearance.Missa.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityHeading="true"
                        android:text="@string/universe_retro_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/retro_controller_badge"
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/missa_pill_surface_bg"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:maxWidth="220dp"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="?attr/missaAccentSuccess"
                    tools:text="Touch + Gamepad ready" />
            </LinearLayout>

            <TextView
                android:id="@+id/retro_intro"
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/universe_retro_intro" />

            <!-- Primary Actions -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retro_import_button"
                        style="@style/Widget.Missa.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginEnd="8dp"
                        android:text="@string/universe_retro_import"
                        app:icon="@drawable/ic_baseline_add_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retro_refresh_button"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:layout_marginEnd="8dp"
                        android:text="@string/universe_retro_refresh" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retro_homebrew_button"
                        style="@style/Widget.Missa.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/missa_pill_touch_height"
                        android:text="@string/universe_retro_downloads" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Console System Filter Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/retro_system_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/missaStrokeSubtle" />

        <!-- Unified ListAdapter + DiffUtil RecyclerView (GAME-01) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/retro_games_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_retro_game_card" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
