<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde Android (Android 6 à 11, android:fullBackupContent).
    Pour Android 12 et plus, voir data_extraction_rules.xml.

    MISSA : AUCUNE donnée de l'application n'est sauvegardée par Android (allowBackup="false"
    dans le manifeste ; ce fichier exclut tout en plus, par sécurité). Une installation neuve,
    même après une désinstallation, repart à zéro : elle ne reçoit que la configuration des
    extensions (extensions/config.json). Avant, Android restaurait automatiquement
    l'historique, « Reprendre », les favoris, les réglages et les extensions de l'ancienne
    installation, ce qui faisait croire que la configuration les apportait.
    L'utilisateur garde sa propre sauvegarde : Paramètres → Mises à jour → Sauvegarde / Restaurer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
