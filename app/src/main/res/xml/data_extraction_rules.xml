<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles d'extraction Android 12+ (android:dataExtractionRules).
    Pour Android 6 à 11, voir backup_descriptor.xml.

    MISSA : rien n'est sauvegardé dans le cloud ni copié lors d'un transfert vers un nouveau
    téléphone (à partir d'Android 12, allowBackup="false" ne bloque plus le transfert direct :
    il faut l'exclure ici). Une installation neuve ne reçoit que la configuration des
    extensions ; l'historique, « Reprendre » et les favoris passent par la sauvegarde manuelle
    de l'application (Paramètres → Mises à jour → Sauvegarde / Restaurer).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
