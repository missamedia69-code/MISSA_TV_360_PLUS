<?xml version="1.0" encoding="utf-8"?>
<!-- TV et paysage : formules et boutons à gauche, QR code à droite, sans défilement
     sur un écran TV (960 x 540 dp). Mêmes identifiants que layout/activity_missa_activation. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/activation_title"
                style="@style/TextAppearance.Missa.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/missa_activation_title" />

            <TextView
                android:id="@+id/activation_message"
                style="@style/TextAppearance.Missa.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="520dp"
                android:text="@string/missa_activation_trial_over" />

            <TextView
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/missa_activation_choose" />

            <LinearLayout
                android:id="@+id/activation_plans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Missa.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/missa_activation_your_code" />

                <TextView
                    android:id="@+id/activation_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textColor="?attr/missaAccentNavigation"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/missa_activation_two_devices" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/activation_link"
                    style="@style/Widget.Missa.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/missa_activation_link" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/activation_check"
                    style="@style/Widget.Missa.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/missa_activation_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/activation_quit"
                    style="@style/Widget.Missa.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/missa_activation_quit" />
            </LinearLayout>

            <TextView
                android:id="@+id/activation_status"
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="520dp" />
        </LinearLayout>

        <!-- QR code (TV uniquement ; masqué sur téléphone/tablette en paysage). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/activation_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@android:color/white"
                android:contentDescription="@string/missa_activation_qr_desc"
                android:padding="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/activation_qr_hint"
                style="@style/TextAppearance.Missa.Caption"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
