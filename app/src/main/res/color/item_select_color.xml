<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation / rail: the checked item uses the navigation accent (green). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/missaAccentNavigation" android:state_checked="true"/>
    <item android:color="?attr/missaAccentNavigation" android:state_focused="true"/>
    <item android:color="?attr/missaAccentNavigation" android:state_selected="true"/>
    <item android:color="?attr/textColor" android:state_checked="false"/>
</selector>
