<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/missaGamepadBtnPressed" />
            <stroke
                android:width="2dp"
                android:color="@color/missaYellowPrimary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/missaGamepadBtnPressed" />
            <stroke
                android:width="2dp"
                android:color="@color/missaYellowPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/missaGamepadBtnFill" />
            <stroke
                android:width="1.5dp"
                android:color="@color/missaGamepadBtnStroke" />
        </shape>
    </item>
</selector>
